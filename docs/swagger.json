{
  "openapi": "3.0.3",
  "info": {
    "version": "1.0.0",
    "title": "Contact Manager API",
    "license": {
      "name": "Apache 2.0",
      "url": "http://www.apache.org/licenses/LICENSE-2.0.html"
    },
    "description": "Бекенд-додаток для управління контактами користувача з аутентифікацією, авторизацією та завантаженням фото."
  },
  "servers": [
    { "url": "http://localhost:3001" },
    { "url": "https://nodejs-hw-mongodb-jwe2.onrender.com" }
  ],
  "tags": [
    { "name": "Auth", "description": "Реєстрація, вхід, вихід, оновлення сесії" },
    { "name": "User", "description": "Отримання поточного користувача" },
    { "name": "Contacts", "description": "CRUD операції з контактами користувача" },
    { "name": "Upload", "description": "Завантаження або оновлення фото для контакта" }
  ],
  "security": [
    { "bearerAuth": [] }
  ],
  "paths": {
    "/api/auth/register": {
      "post": {
        "tags": ["Auth"],
        "summary": "Реєстрація нового користувача",
        "description": "Цей ендпоінт дозволяє зареєструвати нового користувача.",
        "operationId": "registerUser",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string" },
                  "password": { "type": "string" }
                },
                "required": ["email", "password"]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Користувача зареєстровано" },
          "400": { "description": "Невірні дані" }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Логін користувача",
        "description": "Користувач входить в систему за email і паролем.",
        "operationId": "loginUser",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string" },
                  "password": { "type": "string" }
                },
                "required": ["email", "password"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Логін успішний",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "accessToken": { "type": "string" },
                    "refreshToken": { "type": "string" }
                  }
                }
              }
            }
          },
          "400": { "description": "Невірні дані" },
          "401": { "description": "Невірний логін або пароль" }
        }
      }
    },
    "/api/contacts": {
      "get": {
        "tags": ["Contacts"],
        "summary": "Отримати всі контакти",
        "operationId": "getAllContacts",
        "parameters": [
          {
            "in": "query",
            "name": "page",
            "schema": { "type": "integer", "default": 1 },
            "description": "Номер сторінки"
          },
          {
            "in": "query",
            "name": "limit",
            "schema": { "type": "integer", "default": 10 },
            "description": "Кількість елементів"
          },
          {
            "in": "query",
            "name": "sortBy",
            "schema": { "type": "string" },
            "description": "Поле для сортування"
          }
        ],
        "responses": {
          "200": {
            "description": "Список контактів",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Contact" }
                }
              }
            }
          },
          "401": { "description": "Користувач не авторизований" }
        }
      },
      "post": {
        "tags": ["Contacts"],
        "summary": "Створити новий контакт",
        "operationId": "createContact",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Contact" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Контакт створено",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Contact" }
              }
            }
          },
          "400": { "description": "Помилка валідації" }
        }
      }
    },
    "/api/contacts/{contactId}": {
      "get": {
        "tags": ["Contacts"],
        "summary": "Отримати контакт за ID",
        "operationId": "getContactById",
        "parameters": [
          {
            "in": "path",
            "name": "contactId",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Контакт знайдений",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Contact" }
              }
            }
          },
          "404": { "description": "Контакт не знайдений" }
        }
      },
      "patch": {
        "tags": ["Contacts"],
        "summary": "Оновити контакт",
        "operationId": "updateContact",
        "parameters": [
          {
            "in": "path",
            "name": "contactId",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Contact" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Контакт оновлено",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Contact" }
              }
            }
          },
          "400": { "description": "Невірні дані" },
          "404": { "description": "Контакт не знайдений" }
        }
      },
      "delete": {
        "tags": ["Contacts"],
        "summary": "Видалити контакт",
        "operationId": "deleteContact",
        "parameters": [
          {
            "in": "path",
            "name": "contactId",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "204": { "description": "Контакт видалено" },
          "404": { "description": "Контакт не знайдений" }
        }
      }
    },
    "/api/contacts/{contactId}/photo": {
      "patch": {
        "tags": ["Upload"],
        "summary": "Завантажити або оновити фото для контакта",
        "operationId": "uploadContactPhoto",
        "parameters": [
          {
            "in": "path",
            "name": "contactId",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "photo": {
                    "type": "string",
                    "format": "binary"
                  }
                },
                "required": ["photo"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Фото завантажено" },
          "400": { "description": "Помилка завантаження або неправильний формат" },
          "404": { "description": "Контакт не знайдено" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Contact": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "email": { "type": "string" },
          "phone": { "type": "string" },
          "photo": { "type": "string", "nullable": true }
        },
        "required": ["name", "email", "phone"]
      }
    }
  }
}