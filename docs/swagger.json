{
  "openapi": "3.1.0",
  "info": {
    "version": "1.0.0",
    "title": "Contact Manager API",
    "license": {
      "name": "Apache 2.0",
      "url": "http://www.apache.org/licenses/LICENSE-2.0.html"
    },
    "description": "Бекенд-додаток для управління контактами користувача з аутентифікацією, авторизацією та роботою з контактами."
  },
  "servers": [
    { "url": "http://localhost:3001" },
    { "url": "https://nodejs-hw-mongodb-jwe2.onrender.com" }
  ],
  "tags": [
    { "name": "Auth", "description": "Реєстрація, вхід, вихід, оновлення сесії" },
    { "name": "User", "description": "Отримання поточного користувача" },
    { "name": "Contacts", "description": "CRUD операції з контактами користувача" }
  ],
  "security": [
    { "bearerAuth": [] }
  ],
  "paths": {
    "/auth/register": {
      "post": {
        "tags": ["Auth"],
        "summary": "Реєстрація нового користувача",
        "description": "Цей ендпоінт дозволяє зареєструвати нового користувача.",
        "operationId": "registerUser",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string" },
                  "password": { "type": "string" }
                },
                "required": ["email", "password"]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Користувача зареєстровано" },
          "400": { "description": "Невірні дані" }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Логін користувача",
        "description": "Користувач входить в систему за email і паролем.",
        "operationId": "loginUser",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string" },
                  "password": { "type": "string" }
                },
                "required": ["email", "password"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Логін успішний",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "accessToken": { "type": "string" },
                    "refreshToken": { "type": "string" }
                  }
                }
              }
            }
          },
          "400": { "description": "Невірні дані" },
          "401": { "description": "Невірний логін або пароль" }
        }
      }
    },
    "/auth/me": {
      "get": {
        "tags": ["User"],
        "summary": "Отримати поточного користувача",
        "description": "Повертає профіль авторизованого користувача за його токеном доступу.",
        "operationId": "getCurrentUser",
        "security": [
          { "bearerAuth": [] }
        ],
        "responses": {
          "200": {
            "description": "Успішна відповідь. Дані користувача.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../swagger/components/schemas.yaml#/User"
                }
              }
            }
          },
          "401": {
            "description": "Неавторизовано. Токен відсутній або недійсний.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../swagger/components/schemas.yaml#/Error"
                }
              }
            }
          }
        }
      }
    },
    "/contacts": {
      "get": {
        "tags": ["Contacts"],
        "summary": "Отримати всі контакти",
        "operationId": "getAllContacts",
        "security": [
          { "bearerAuth": [] }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "page",
            "schema": { "type": "integer", "default": 1 },
            "description": "Номер сторінки"
          },
          {
            "in": "query",
            "name": "limit",
            "schema": { "type": "integer", "default": 10 },
            "description": "Кількість елементів"
          },
          {
            "in": "query",
            "name": "sortBy",
            "schema": { "type": "string" },
            "description": "Поле для сортування"
          }
        ],
        "responses": {
          "200": {
            "description": "Список контактів",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "../swagger/components/schemas.yaml#/Contact" }
                }
              }
            }
          },
          "401": {
            "description": "Користувач не авторизований",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../swagger/components/schemas.yaml#/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Contacts"],
        "summary": "Створити новий контакт",
        "operationId": "createContact",
        "security": [
          { "bearerAuth": [] }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "../swagger/components/schemas.yaml#/NewContact"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Контакт створено",
            "content": {
              "application/json": {
                "schema": { "$ref": "../swagger/components/schemas.yaml#/Contact" }
              }
            }
          },
          "400": {
            "description": "Помилка валідації",
            "content": {
              "application/json": {
                "schema": { "$ref": "../swagger/components/schemas.yaml#/Error" }
              }
            }
          }
        }
      }
    },
    "/contacts/{contactId}": {
      "get": {
        "tags": ["Contacts"],
        "summary": "Отримати контакт за ID",
        "operationId": "getContactById",
        "security": [
          { "bearerAuth": [] }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "contactId",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Контакт знайдений",
            "content": {
              "application/json": {
                "schema": { "$ref": "../swagger/components/schemas.yaml#/Contact" }
              }
            }
          },
          "401": {
            "description": "Неавторизовано",
            "content": {
              "application/json": {
                "schema": { "$ref": "../swagger/components/schemas.yaml#/Error" }
              }
            }
          },
          "404": {
            "description": "Контакт не знайдений",
            "content": {
              "application/json": {
                "schema": { "$ref": "../swagger/components/schemas.yaml#/Error" }
              }
            }
          }
        }
      },
      "patch": {
        "tags": ["Contacts"],
        "summary": "Оновити контакт",
        "operationId": "updateContact",
        "security": [
          { "bearerAuth": [] }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "contactId",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": { "$ref": "../swagger/components/schemas.yaml#/UpdateContact" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Контакт оновлено",
            "content": {
              "application/json": {
                "schema": { "$ref": "../swagger/components/schemas.yaml#/Contact" }
              }
            }
          },
          "400": {
            "description": "Невірні дані",
            "content": {
              "application/json": {
                "schema": { "$ref": "../swagger/components/schemas.yaml#/Error" }
              }
            }
          },
          "401": {
            "description": "Неавторизовано",
            "content": {
              "application/json": {
                "schema": { "$ref": "../swagger/components/schemas.yaml#/Error" }
              }
            }
          },
          "404": {
            "description": "Контакт не знайдений",
            "content": {
              "application/json": {
                "schema": { "$ref": "../swagger/components/schemas.yaml#/Error" }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["Contacts"],
        "summary": "Видалити контакт",
        "operationId": "deleteContact",
        "security": [
          { "bearerAuth": [] }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "contactId",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Контакт успішно видалено"
          },
          "401": {
            "description": "Неавторизовано",
            "content": {
              "application/json": {
                "schema": { "$ref": "../swagger/components/schemas.yaml#/Error" }
              }
            }
          },
          "404": {
            "description": "Контакт не знайдено",
            "content": {
              "application/json": {
                "schema": { "$ref": "../swagger/components/schemas.yaml#/Error" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}